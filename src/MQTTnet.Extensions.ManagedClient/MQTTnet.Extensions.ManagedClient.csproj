<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<PreserveCompilationReferences>true</PreserveCompilationReferences>
		<PackageId>IoTGateway.MQTTnet.Extensions.ManagedClient</PackageId>
		<Title>MQTTnet.Extensions.ManagedClient</Title>
		<Authors>iotgateway.net</Authors>
		<Company>iioter</Company>
		<Product>MQTTnet.Extensions.ManagedClient</Product>
		<Description>Managed MQTT client extension for MQTTnet 8.x with automatic reconnect, subscription synchronization, and queued publishing.</Description>
		<PackageTags>mqtt;mqttnet;mqttclient;managed-client;iot;iiot</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/iioter/MQTTnet.Extensions.ManagedClient</PackageProjectUrl>
		<RepositoryUrl>https://github.com/iioter/MQTTnet.Extensions.ManagedClient</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>iotgateway.net</Copyright>
		<Version>5.0</Version>
		<AssemblyVersion>5.0</AssemblyVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>MQTTnet.Extensions.ManagedClient.jpg</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MQTTnet" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\MQTTnet.Extensions.ManagedClient.jpg" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>

